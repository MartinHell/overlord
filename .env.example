# API settings
PORT=3000
# Set to "production" to stop serving the GraphQL playground on /
ENVIRONMENT=development

# Database settings
# DB_TYPE is "postgres" (default) or "sqlite"
DB_TYPE="postgres"
DB_URL="host=127.0.0.1 user=<DBUSER> password=<DBPASSWORD> dbname=<DBNAME> port=5432"

# For a local SQLite database instead:
# DB_TYPE="sqlite"
# DB_URL="overlord.db"

# DCS-GRPC settings
GRPC_SERVER_ADDRESS="127.0.0.1:50051"

# Logging
LOG_LEVEL="info"
LOG_ENCODING="json"
